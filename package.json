{
  "name": "120fps",
  "version": "0.2.1",
  "type": "module",
  "description": "Zero-config UI component performance profiler. Real browser, real metrics.",
  "license": "MIT",
  "repository": "https://github.com/justinschmitz97/120fps",
  "bin": {
    "120fps": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "start": "tsc && node dist/cli.js",
    "test": "vitest run test/unit/",
    "test:unit": "vitest run test/unit/",
    "test:e2e": "vitest run test/e2e/",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.52.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.1.0"
  }
}
