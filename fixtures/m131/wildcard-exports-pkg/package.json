{
  "name": "@fixture/wildcard-fontsource",
  "version": "1.0.0",
  "exports": {
    ".": { "sass": "./index.css", "default": "./index.css" },
    "./*": { "sass": "./*.css", "default": "./*.css" },
    "./*.css": { "sass": "./*.css", "default": "./*.css" },
    "./package.json": "./package.json"
  }
}
